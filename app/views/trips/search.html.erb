<div class="container mt-5">
  <div class="card p-4 shadow-lg">
    <h1 class="text-center mb-4">Search Buses</h1>

    <%= form_with url: search_trips_path, method: :get, local: true, class: "row g-3" do |f| %>
      <div class="col-md-4">
        <%= label_tag :start_location, "From", class: "form-label" %>
        <%= select_tag :start_location, options_for_select(Route.distinct.pluck(:start_location), params[:start_location]), include_blank: "Select start", class: "form-select" %>
      </div>
      <div class="col-md-4">
        <%= label_tag :end_location, "To", class: "form-label" %>
        <%= select_tag :end_location, options_for_select(Route.distinct.pluck(:end_location), params[:end_location]), include_blank: "Select destination", class: "form-select" %>
      </div>
      <div class="col-md-3">
        <%= label_tag :date, "Travel Date", class: "form-label" %>
        <%= date_field_tag :date, params[:date], min: Date.current.strftime("%Y-%m-%d"), class: "form-control" %>
      </div>

      <div class="col-md-1 d-flex align-items-end">
        <%= submit_tag "Search", class: "btn btn-primary w-100" %>
      </div>
    <% end %>
  </div>

  <% if @trips.present? %>
    <h2 class="mt-5">Available Trips</h2>
    <table class="table table-striped table-hover mt-3">
      <thead class="table-dark">
        <tr>
          <th>Bus</th>
          <th>Route</th>
          <th>Departure</th>
          <th>Arrival</th>
          <th>Seats</th>
          <th>Fare</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% @trips.each do |trip| %>
          <tr>
            <td><%= trip.bus.bus_num %></td>
            <td><%= trip.route.start_location %> → <%= trip.route.end_location %></td>
            <td><%= trip.departure_time.strftime("%d %b %Y %I:%M %p") %></td>
            <td><%= trip.arrival_time.strftime("%d %b %Y %I:%M %p") %></td>
            <td>
              <% if trip.avail_seats > 0 %>
                <span class="badge bg-success"><%= trip.avail_seats %></span>
              <% else %>
                <span class="badge bg-danger">Sold Out</span>
              <% end %>
            </td>
            <td><%= number_to_currency(trip.fare) %></td>
            <td>
              <% if trip.avail_seats > 0 %>
                <% if user_signed_in? %>
                  <%= link_to "Book Now", new_booking_path(trip_id: trip.id), class: "btn btn-success btn-sm" %>
                <% else %>
                  <%= link_to "Login to Book", new_user_session_path, class: "btn btn-outline-primary btn-sm" %>
                <% end %>
              <% else %>
                <button class="btn btn-secondary btn-sm" disabled>Sold Out</button>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% elsif params[:date].present? || params[:start_location].present? || params[:end_location].present? %>
  <div class="alert alert-warning mt-4">No trips found for the selected search criteria.</div>
<% end %>
</div>
