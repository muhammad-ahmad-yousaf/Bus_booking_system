<div id="<%= dom_id trip %>">
  <p>
    <strong>Bus:</strong>
    <%= trip.bus_id %>
  </p>

  <p>
    <strong>Route:</strong>
    <%= trip.route_id %>
  </p>

  <p>
    <strong>Departure time:</strong>
    <%= trip.departure_time %>
  </p>

  <p>
    <strong>Arrival time:</strong>
    <%= trip.arrival_time %>
  </p>

  <p>
    <strong>Avail seats:</strong>
    <%= trip.avail_seats %>
  </p>

  <p>
    <strong>Fare:</strong>
    <%= trip.fare %>
  </p>

</div>
