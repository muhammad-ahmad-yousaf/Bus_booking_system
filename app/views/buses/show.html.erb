<div class="container mt-5">
  <div class="card border-dark">
    <div class="card-header bg-dark text-white">
      <h2 class="mb-0">Bus <%= @bus.bus_num %></h2>
    </div>
    <div class="card-body">
      <p class="card-text">
        <strong>Capacity:</strong>
        <span class="badge bg-success"><%= @bus.capacity %> seats</span>
      </p>

      <p class="card-text">
        <strong>Type:</strong>
        <% case @bus.bus_type.downcase %>
        <% when "ac" %>
          <span class="badge bg-info text-dark">AC</span>
        <% when "non-ac" %>
          <span class="badge bg-secondary">Non-AC</span>
        <% else %>
          <span class="badge bg-light text-dark"><%= @bus.bus_type %></span>
        <% end %>
      </p>
    </div>
    <div class="card-footer">
      <%= link_to "Back", buses_path, class: "btn btn-outline-secondary" %>
      <% if user_signed_in? && current_user.admin? %>
        <%= link_to "Edit", edit_bus_path(@bus), class: "btn btn-primary ms-2" %>
      <% end %>
    </div>
  </div>
</div>
