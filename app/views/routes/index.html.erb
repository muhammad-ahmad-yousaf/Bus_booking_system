<div class="d-flex justify-content-between align-items-center mb-3">
  <h1>Routes</h1>
  <%= link_to "Add Route", new_route_path, class: "btn btn-success" %>
</div>

<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>Start</th>
      <th>End</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @routes.each do |route| %>
      <tr>
        <td><%= route.start_location %></td>
        <td><%= route.end_location %></td>
        <td>
          <%= link_to "Edit", edit_route_path(route), class: "btn btn-warning btn-sm" %>
          <%= link_to "Delete", route, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= paginate @routes%>
