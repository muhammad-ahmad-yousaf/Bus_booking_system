<div class="card p-4">
  <% if route.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(route.errors.count, "error") %> prevented this route from being saved:</h4>
      <ul>
        <% route.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with(model: route, local: true) do |form| %>
    <div class="mb-3">
      <%= form.label :start_location, class: "form-label" %>
      <%= form.text_field :start_location, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= form.label :end_location, class: "form-label" %>
      <%= form.text_field :end_location, class: "form-control" %>
    </div>

    <%= form.submit "Save Route", class: "btn btn-primary" %>
  <% end %>
</div>
