<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
  <div class="card shadow-lg border-0" style="width: 450px; border-radius: 15px;">
    <div class="card-body p-4">
      <h3 class="card-title text-center mb-4">Forgot your password?</h3>

      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <!-- Email Field -->
        <div class="mb-3">
          <%= f.label :email, class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
        </div>

        <!-- Submit Button -->
        <div class="d-grid mb-3">
          <%= f.submit "Send reset instructions", class: "btn btn-primary btn-lg" %>
        </div>
      <% end %>

      <!-- Links (back to login / sign up) -->
      <div class="text-center mt-3">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
