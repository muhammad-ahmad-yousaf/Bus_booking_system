

<% if user_signed_in? && current_user.admin?%>
  <h1 class="text-center">Admin Dashboard</h1>
  <h2>All Bookings</h2>
<% else %>
  <h2>My Bookings</h2>
<%end%>

<table class="table table-striped table-hover">
  <thead class="table-dark">
    <tr>
      <th>Bus Number</th>
      <th>Trip (FROM → TO)</th>
      <th>Seat Number</th>
      <th>Bus Type</th>
      <th>Status</th>
      <th>Total Fare</th>
      <% if user_signed_in? && current_user.admin?%>
        <th>Customer Name</th>
      <%end%>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @bookings.each do |booking| %>
      <tr>
        <td><%= booking.trip.bus.bus_num %></td>
        <td><%= booking.trip.route.start_location %> → <%= booking.trip.route.end_location %></td>
        <td><%= booking.seat_number %></td>
        <td><%= booking.trip.bus.bus_type %></td>
        <td><%= booking.status&.humanize || "Pending" %></td>
        <td>Rs. <%= booking.trip.fare %></td>
        <% if user_signed_in? && current_user.admin?%>
          <td><%= booking.user.name %></td>
        <% end %>
        <td>
          <% if user_signed_in? %>
            <%= link_to "Show Details", booking, class: "btn btn-success btn-sm"%>
            <%= link_to "Edit", edit_booking_path(booking), class: "btn btn-warning btn-sm" %>
            <%= link_to "Delete", booking, method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-danger btn-sm" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
