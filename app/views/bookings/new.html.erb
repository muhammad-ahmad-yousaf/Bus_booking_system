<div class="container mt-5">
  <div class="card shadow-lg p-4">
    <h1 class="mb-4 text-primary fw-bold text-center">
      <i class="bi bi-bus-front me-2"></i>Book Trip
    </h1>

    <% unless @trip %>
      <div class="alert alert-danger">No trip selected.</div>
      <% return %>
    <% end %>

    <% @booked_seats ||= Booking.where(trip_id: @trip.id).pluck(:seat_number) %>
    <% selected_seat = params.dig(:booking, :seat_number) || @booking&.seat_number %>
    <% total_seats = @trip.avail_seats.to_i %>

    <!-- Trip Details -->
    <div class="row mb-4 text-center">
      <div class="col-md-4 mb-2">
        <div class="border rounded p-3 bg-light shadow-sm">
          <i class="bi bi-geo-alt"></i>
          <strong>Route</strong>
          <p class="mb-0"><%= @trip.route.start_location %> → <%= @trip.route.end_location %></p>
        </div>
      </div>
      <div class="col-md-4 mb-2">
        <div class="border rounded p-3 bg-light shadow-sm">
          <i class="bi-calendar-date "></i>
          <strong>Departure</strong>
          <p class="mb-0"><%= @trip.departure_time.strftime("%d %b %Y %I:%M %p") %></p>
        </div>
      </div>
      <div class="col-md-4 mb-2">
        <div class="border rounded p-3 bg-light shadow-sm">
          <i class="bi bi-person-fill"></i>
          <strong>Seats Left</strong>
          <p class="mb-0"><%= total_seats - @booked_seats.size %> / <%= total_seats %></p>
        </div>
      </div>
    </div>

    <%= form_with(model: @booking, url: bookings_path, local: true, html: { id: "booking-form" }) do |form| %>
      <%= form.hidden_field :trip_id, value: @trip.id %>
      <%= form.hidden_field :seat_number, id: "booking_seat_number", value: selected_seat, name: "booking[seat_number]" %>


      <!-- Seat Layout -->
      <div class="p-3 rounded bg-light">
        <div class="seat-grid">
          <% seat = 1 %>
          <% rows = (total_seats / 4.0).ceil %>
          <% rows.times do %>
            <% left = [seat, seat + 1] %>
            <% right = [seat + 2, seat + 3] %>
            <% seat += 4 %>

            <% left.each do |s| %>
              <% next if s > total_seats %>
              <% is_booked = @booked_seats.include?(s) %>
              <button type="button"
                      class="seat btn w-100 <%= is_booked ? 'btn-secondary' : 'btn-success' %> <%= 'active' if selected_seat.to_i == s %>"
                      data-seat="<%= s %>"
                      <%= 'disabled' if is_booked %>>
                <%= s %>
              </button>
            <% end %>

            <div class="aisle"></div>

            <% right.each do |s| %>
              <% next if s > total_seats %>
              <% is_booked = @booked_seats.include?(s) %>
              <button type="button"
                      class="seat btn w-100 <%= is_booked ? 'btn-secondary' : 'btn-success' %> <%= 'active' if selected_seat.to_i == s %>"
                      data-seat="<%= s %>"
                      <%= 'disabled' if is_booked %>>
                <%= s %>
              </button>
            <% end %>
          <% end %>
        </div>

        <!-- Seat Legend -->
        <div class="mt-3 small text-muted text-center">
          <span class="badge bg-success me-2">&nbsp;</span>Available
          <span class="badge bg-warning text-dark mx-2">&nbsp;</span>Selected
          <span class="badge bg-secondary mx-2">&nbsp;</span>Booked
        </div>
      </div>

      <div class="text-center mt-4">
        <%= form.submit "Confirm Booking", class: "btn btn-primary btn-lg px-5" %>
      </div>
    <% end %>
  </div>
</div>

<!-- Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
  .seat-grid {
    display: grid;
    grid-template-columns: repeat(2, 64px) 48px repeat(2, 64px);
    grid-auto-rows: 56px;
    gap: 10px 18px;
    justify-content: center;
  }
  .seat-grid .aisle { pointer-events: none; }
  .seat {
    font-weight: 600;
    border-radius: .5rem;
  }
  .seat.active {
    background-color: #ffc107 !important;
    color: #212529 !important;
    border-color: #ffc107 !important;
  }
</style>

<script>
const initSeatPicker = () => {
  const form = document.getElementById("booking-form");
  if (!form) return;

  const hidden = document.getElementById("booking_seat_number");
  const submitBtn = form.querySelector('input[type="submit"], button[type="submit"]');
  const seats  = Array.from(document.querySelectorAll(".seat:not([disabled])"));

  seats.forEach(btn => {
    btn.addEventListener("click", () => {
      seats.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      hidden.value = btn.dataset.seat;
    });
  });

  form.addEventListener("submit", (e) => {
    if (!hidden.value) {
      e.preventDefault(); // stop the form submission
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.removeAttribute("data-turbo-submits-with");

      }
      alert("Please select a seat before confirming your booking.");
    }
  });
};

document.addEventListener("turbo:load", initSeatPicker);
document.addEventListener("DOMContentLoaded", initSeatPicker);

</script>
